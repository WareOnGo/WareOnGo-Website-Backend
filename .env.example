# Database Configuration
DATABASE_URL="your_postgresql_connection_string_here"

# Server Configuration
PORT=3000

# Redis Configuration
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password_here
REDIS_HOST=your_redis_host_here
REDIS_PORT=6379

# CORS Origins (comma-separated)
CORS_ORIGINS=https://wareongo.com,http://localhost:8080,http://localhost:3000,http://localhost:5173,http://localhost:4173

# Cache Settings
CACHE_TTL=900

# Google Sheets webhook (Apps Script web app) — form submissions are appended as rows.
# See scripts/google-sheets-webhook.gs for the Apps Script code and setup steps.
SHEETS_WEBHOOK_URL=your_apps_script_web_app_url_here
SHEETS_WEBHOOK_TOKEN=your_shared_secret_here

# EmailJS Configuration for Email Notifications (No template needed - sends raw text emails)
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_here

# Cloudflare R2 — used by scripts/compress_photos_to_webp.js to write WebP
# variants alongside originals (under the webp/ prefix). The website reads
# Warehouse.photosWebp and falls back to Warehouse.photos when absent.
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_PUBLIC_URL=https://your-public-r2-host
# Optional tuning (defaults: 1280 / 75)
WEBP_MAX_WIDTH=1280
WEBP_QUALITY=75
