/// CMS-managed warehousing blogs. Rendered by the public site at
/// /blogs/{slug}; the build reads PUBLISHED rows and writes
/// src/data/blogs.generated.ts (see scripts/generate-blogs.mjs).
///
/// Field names track the Article JSON-LD they feed, so the SEO/GEO contract
/// stays legible from the schema alone.
model Blog {
  id              Int        @id @default(autoincrement())
  slug            String     @unique
  /// On-page H1.
  title           String
  /// <title> tag.
  seoTitle        String
  /// Meta description + Article.description.
  description     String
  /// Direct-answer "In short" callout — the speakable GEO block answer
  /// engines extract first. Rendered at #blog-summary.
  summary         String
  /// Article.keywords, joined comma-separated at render.
  keywords        String[]   @default([])
  /// BlogBlock[] — discriminated union on `kind`: h2/h3/p/ul/ol/table.
  blocks          Json
  /// BlogFaq[] — {q,a}; drives both the visible accordion and FAQPage LD,
  /// which must stay identical for the schema to validate.
  faqs            Json
  /// Slugs of related blogs, rendered as cross-links.
  related         String[]   @default([])
  /// Article.datePublished. Falls back to dateModified when absent.
  datePublished   DateTime?  @db.Date
  /// Article.dateModified, and the "Updated" line on the page.
  dateModified    DateTime   @db.Date
  /// Position in the /blogs ItemList LD and index page.
  sortOrder       Int        @default(0)
  status          BlogStatus @default(DRAFT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  /// When that snapshot was taken. Records a deploy being *triggered*, not a
  /// build succeeding — the CMS has no way to observe the build's outcome.
  deployedAt      DateTime?
  /// Snapshot of the content fields as of the last deploy the CMS triggered.
  /// The CMS compares the live row against this to tell whether a blog has
  /// edits that haven't reached the site yet ("Staged"), and to offer a revert.
  /// Null means the blog has never been included in a deploy.
  deployedContent Json?
  /// Optional byline. Shown under the H1 and emitted as Article.author (a
  /// Person); null falls back to the WareOnGo organisation, which is what every
  /// blog did before this column existed.
  author          String?

  @@index([status, sortOrder])
}

/// CMS-authored editorial content for one micromarket listing page
/// (/listings/city/{citySlug}/{slug}). Deliberately optional: a micromarket
/// with no PUBLISHED row here keeps rendering the plain listing grid it renders
/// today, and one with a row renders the full editorial template over the same
/// live inventory. That is the whole if/else — presence of a row is the switch.
///
/// Only prose, images and FAQs live here. Every number on the page (listing
/// count, rent and size ranges, construction mix, compliance counts, the peer
/// rent chart) is computed from live listings at build time, so this table can
/// never contradict inventory. Authored copy must therefore avoid hard numbers
/// it does not own.
model MicromarketPage {
  id               Int                   @id @default(autoincrement())
  /// The {city} URL segment — a city page slug (locationLoader.ts `slugify`).
  citySlug         String
  /// The {micromarket} URL segment (locationLoader.ts `slugifyMicromarket`).
  slug             String
  /// Display name, for the CMS list only. The site uses the canonical name it
  /// derives from listings, so a stale value here can never reach a page.
  name             String
  /// <title> tag.
  seoTitle         String
  /// Meta description + CollectionPage.description.
  metaDescription  String
  /// On-page H1.
  h1               String
  /// Small uppercase line above the H1. Null falls back to a derived default.
  heroEyebrow      String?
  /// Lead paragraph. The one required prose slot — without it there is no page.
  heroProse        String
  /// {url, alt, width, height} or null. Uploaded through the CMS to R2.
  heroImage        Json?
  /// Section headings. Null falls back to a default built from the place name.
  marketHeading    String?
  marketProse      String?
  marketImage      Json?
  rentsHeading     String?
  rentsProse       String?
  specHeading      String?
  specProse        String?
  inventoryHeading String?
  /// MicromarketFaq[] — {q,a}. Drives both the visible accordion and the
  /// FAQPage LD, which must stay identical for the schema to validate.
  faqs             Json
  /// Slugs of blogs to cross-link in the page footer ("Editorial" row).
  relatedBlogs     String[]              @default([])
  /// Manual corrections to the figures the website derives from live listings.
  ///
  /// Optional and partial: whatever is set here wins, everything else stays
  /// computed. It exists because the listings are free-text in places — a rate
  /// typed as an annual figure, a clear height recorded in metres — and an
  /// editor who knows the belt can correct one number without anyone having to
  /// fix every row first.
  ///
  /// Deliberately cannot override the listing count, the construction and
  /// flooring mix, or the peer chart. The count has to match the grid rendered
  /// underneath it on the same page; the mixes are derived label-by-label from
  /// the same rows the grid shows; and a peer's median belongs to that peer's
  /// own page, where it is computed the same way.
  ///
  /// Shape (all keys optional), validated by the CMS:
  ///   { rent: {min,median,max}, size: {min,max},
  ///     clearHeight: {min,median,max}, docksMedian, fireNoc, commercialClu }
  statOverrides    Json?
  status           MicromarketPageStatus @default(DRAFT)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  /// Snapshot of the content fields as of the last deploy the CMS triggered,
  /// and when that was. Same contract as Blog.deployedContent: it records a
  /// deploy being *triggered*, not a build succeeding.
  deployedAt       DateTime?
  deployedContent  Json?

  @@unique([citySlug, slug])
  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model labeled_warehouse_images {
  id             Int        @id @default(autoincrement())
  warehouseId    Int
  imageUrl       String     @unique
  classification ImageClass
  description    String?
  model          String
  confidence     Float?
  createdAt      DateTime   @default(now())

  @@index([classification])
  @@index([warehouseId])
