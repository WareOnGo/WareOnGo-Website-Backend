  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model osm_highway {
  id         Int                       @id @default(autoincrement())
  osmType    String                    @db.Char(1)
  osmId      BigInt
  ref        String?
  highway    String
  name       String?
  tags       Json?
  sourceFile String?
  importedAt DateTime                  @default(now())
  lastSeenAt DateTime                  @default(now())
  geog       Unsupported("geography")?
  refs       String[]                  @default([])

  @@unique([osmType, osmId])
  @@index([geog], map: "osm_highway_geog_gist", type: Gist)
  @@index([highway])
  @@index([lastSeenAt])
  @@index([ref])
  @@index([refs], type: Gin)
}

model osm_ingest_tile {
  id           Int       @id @default(autoincrement())
  tileKey      String
  category     String
  south        Float
  west         Float
  north        Float
  east         Float
  status       String    @default("pending")
  elementCount Int       @default(0)
  storedCount  Int       @default(0)
  attempts     Int       @default(0)
  lastError    String?
  queryHash    String?
  durationMs   Int?
  bytes        Int?
  fetchedAt    DateTime?
  updatedAt    DateTime

  @@unique([tileKey, category])
  @@index([category, status])
  @@index([status])
}

model warehouse_proximity {
  id              Int       @id @default(autoincrement())
  warehouseId     Int
  category        String
  status          String    @default("OK")
  landmarkName    String?
  poiSource       String?
  poiId           String?
  poiLat          Float?
  poiLng          Float?
  roadKm          Float?
  driveMinutes    Int?
  provider        String?
  profile         String?
  candidates      Int?
  warnings        String[]  @default([])
  attempts        Int       @default(1)
  lastError       String?
  computedAt      DateTime  @default(now())
  computedFromLat Float?
  computedFromLng Float?
  poiWatermark    DateTime?
  Warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, category])
  @@index([category, status])
  @@index([computedAt])
}

