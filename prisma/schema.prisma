model osm_poi {
  id         Int                       @id @default(autoincrement())
  osmType    String                    @db.Char(1)
  osmId      BigInt
  category   String
  name       String?
  lat        Float
  lng        Float
  tags       Json?
  sourceFile String?
  importedAt DateTime                  @default(now())
  geog       Unsupported("geography")? @default(dbgenerated("\nCASE\n    WHEN ((lng IS NOT NULL) AND (lat IS NOT NULL)) THEN (st_setsrid(st_makepoint(lng, lat), 4326))::geography\n    ELSE NULL::geography\nEND"))
  lastSeenAt DateTime                  @default(now())

  @@unique([osmType, osmId, category])
  @@index([category])
  @@index([geog], map: "osm_poi_geog_gist", type: Gist)
  @@index([lat, lng])
  @@index([lastSeenAt])
}

model point_of_interest {
  id        String                    @id
  name      String
  category  String
  lat       Float
  lng       Float
  notes     String?
  city      String?
  createdBy String
  createdAt DateTime                  @default(now())
  updatedAt DateTime
  geog      Unsupported("geography")? @default(dbgenerated("\nCASE\n    WHEN ((lng IS NOT NULL) AND (lat IS NOT NULL)) THEN (st_setsrid(st_makepoint(lng, lat), 4326))::geography\n    ELSE NULL::geography\nEND"))

  @@index([category])
  @@index([geog], map: "point_of_interest_geog_gist", type: Gist)
  @@index([lat, lng])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
