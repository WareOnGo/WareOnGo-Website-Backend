generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Warehouse {
  warehouseOwnerType          String?
  warehouseType               String
  address                     String
  googleLocation              String?
  city                        String
  state                       String
  postalCode                  String?
  zone                        String
  contactPerson               String
  contactNumber               String
  totalSpaceSqft              Int[]
  offeredSpaceSqft            String?
  numberOfDocks               String?
  clearHeightFt               String?
  compliances                 String
  otherSpecifications         String?
  ratePerSqft                 String
  availability                String?
  uploadedBy                  String
  isBroker                    String?
  photos                      String?
  createdAt                   DateTime?             @default(now())
  statusUpdatedAt             DateTime?             @updatedAt @map("status_updated_at")
  id                          Int                   @id @default(autoincrement())
  visibility                  Boolean?              @default(false)
  media                       Json?
  alt_phone_number            String?
  land_parcel_size            String?
  builtup_area                String?
  owner_warmnth               String?
  distance_from_highway       String?
  is_builder                  Boolean?
  owner_of_multiple_sites     String?
  carpet_area                 String?
  nearest_transport           String?
  fire_exits                  String?
  fire_compliance_cert_type   String?
  negotiated_rent             String?
  washroom_count              String?
  ownerCompanyName            String?
  ownerAltPoc                 String?
  gateSizeFt                  String?
  dockApronLengthFt           String?
  setbackArea                 String?
  ccRoads                     String?
  wallAndSecurityRoom         String?
  plinthHeightFt              String?
  dockDimension               String?
  canopyType                  String?
  dockPlatformType            String?
  otherDockingSpecs           String?
  flooringType                String?
  floorStrengthPerSqm         String?
  ventilationType             String?
  ventilationAirChangesPerDay String?
  insulationPresent           String?
  insulationType              String?
  lightingDetails             String?
  wogVerified                 Boolean?
  centreHeight                String?
  listing_type                String?
  photosWebp                  String?
  handoverDate                DateTime?             @db.Date
  lockInDate                  DateTime?             @db.Date
  status                      String?
  cam                         String?
  chargeableArea              Int?
  scoutNotes                  String?
  liftAccess                  Boolean?
  liftLoadCapacity            String?
  passengerLiftCount          String?
  serviceLiftCount            String?
  totalFloors                 String?
  micromarket                 String[]              @default([])
  handoverLeadUnit            HandoverLeadUnit?
  handoverLeadValue           Int?
  handoverType                HandoverType?
  waterSupply                 WaterSupply?
  suitableFor                 String[]              @default([])
  warehouseData               WarehouseData?
  WarehouseVisitNote          WarehouseVisitNote[]
  warehouse_proximity         warehouse_proximity[]

  @@index([address(ops: raw("gin_trgm_ops"))], map: "idx_warehouse_address_trgm", type: Gin)
  @@index([clearHeightFt], map: "idx_warehouse_clear_height")
  @@index([id, city, state, warehouseType, ratePerSqft, address, zone, contactPerson], map: "idx_warehouse_common_fields")
  @@index([compliances(ops: raw("gin_trgm_ops"))], map: "idx_warehouse_compliances_trgm", type: Gin)
  @@index([ratePerSqft], map: "idx_warehouse_rate")
  @@index([totalSpaceSqft], map: "idx_warehouse_space_gin", type: Gin)
}

model WarehouseData {
  id                  Int                       @id @default(autoincrement())
  latitude            Float?
  longitude           Float?
  embedding           Unsupported("vector")?
  warehouseId         Int                       @unique
  fireNocAvailable    Boolean?
  fireSafetyMeasures  String?
  landType            String?
  approachRoadWidth   String?
  dimensions          String?
  parkingDockingSpace String?
  pollutionZone       String?
  powerKva            String?
  vaastuCompliance    String?
  geog                Unsupported("geography")? @default(dbgenerated("\nCASE\n    WHEN ((longitude IS NOT NULL) AND (latitude IS NOT NULL)) THEN (st_setsrid(st_makepoint(longitude, latitude), 4326))::geography\n    ELSE NULL::geography\nEND"))
  warehouse           Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([geog], map: "WarehouseData_geog_gist", type: Gist)
}

model Enquiry {
  id          Int       @id @default(autoincrement())
  name        String
  phoneNumber String    @map("phone_number")
  email       String?
  source      String
  createdat   DateTime? @default(now()) @db.Timestamptz(6)
}

model Draft {
  sender_number  String   @id
  status         String
  warehouse_data Json
  image_urls     String[]
  created_at     DateTime @default(now())
}

model MessageLog {
  id            Int      @id @default(autoincrement())
  received_at   DateTime @default(now())
  sender_number String
  message_body  String
  status        String
  error_message String?
  image_url     String?
}

model VerifiedNumber {
  id                  Int            @id @default(autoincrement())
  phone_number        String         @unique
  name                String
  is_active           Boolean        @default(true)
  created_at          DateTime       @default(now())
  twenty_user_id      String?        @unique(map: "verified_number_twenty_user_id_key")
  email               String?        @unique(map: "verified_number_email_key")
  empID               String?        @unique(map: "verified_number_empID_key")
  role                String         @default("EMPLOYEE")
  adminAccess         Boolean        @default(false)
  callDashboardAccess Boolean        @default(false)
  dashboardAccess     Boolean        @default(false)
  reviewerAccess      Boolean        @default(false)
  Employee            Employee?
  agent_session       agent_session?
  conversation        conversation?
  media_context       media_context?
  reminder            reminder[]
  task                task[]
}

model customer_request {
  id                      BigInt    @id @default(autoincrement())
  full_name               String
  phone_number            String?
  company_name            String?
  preferred_location      String?
  additional_requirements String?
  created_at              DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model VideoComposition {
  id                     String   @id @db.Uuid
  composition_components Json
  created_at             DateTime @default(now())
  updated_at             DateTime
}

model CronRunLog {
  id         BigInt   @id @default(autoincrement())
  jobName    String
  ranAt      DateTime @default(now())
  status     String
  durationMs Int
  metadata   Json?
  notes      String?

  @@index([jobName, ranAt])
}

model GeocodeAttempt {
  id            Int       @id @default(autoincrement())
  warehouseId   Int       @unique
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime  @default(now())
  lastVia       String?
  lastError     String?
  succeededAt   DateTime?

  @@index([lastAttemptAt])
  @@index([succeededAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id        String   @id
  action    String
  entity    String
  entityId  String?
  context   String?
  metadata  Json?
  userEmail String
  userName  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
